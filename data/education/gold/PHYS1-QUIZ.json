    "PHYS1-QUIZ-Q01": {
      "answer": "v=9 m/s; displacement=12 m",
      "points": 8,
      "accepted": [
        "9 m/s"
      ],
      "solution_steps": [
        "v=v\u2080+at=3+3(2)=9 m/s",
        "\u0394x=v\u2080t+\u00bdat\u00b2=3(2)+\u00bd(3)(2)\u00b2=12 m"
      ],
      "verifier": "kinematics"
    },
    "PHYS1-QUIZ-Q02": {
      "answer": "a=1.90 m/s\u00b2; friction opposes motion",
      "points": 8,
      "accepted": [
        "1.90 m/s"
      ],
      "solution_steps": [
        "N=mg=68.6 N; friction=\u03bcN=13.7 N",
        "\u03a3F=27\u221213.7=13.3 N",
        "a=\u03a3F/m=1.90 m/s\u00b2"
      ],
      "verifier": "newtons_law"
    },
    "PHYS1-QUIZ-Q03": {
      "answer": "v=12.52 m/s",
