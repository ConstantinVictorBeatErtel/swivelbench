    "PHYS1-QUIZ-Q04": {
      "answer": "total momentum before equals after when external impulse is negligible",
      "points": 5,
      "accepted": [
        "momentum conserved"
      ],
      "solution_steps": [
        "p_total,before = p_total,after",
        "It applies when external impulse on the system is negligible."
      ],
      "verifier": "momentum_explanation"
    },
    "PHYS1-QUIZ-Q05": {
      "answer": "impulse=3 N\u00b7s; momentum changes by 3 kg\u00b7m/s",
      "points": 6,
      "accepted": [
        "3 N\u00b7s"
      ],
      "solution_steps": [
        "Impulse is area under F(t): J=F\u0394t=6(0.5)=3 N\u00b7s.",
        "\u0394p=J, so momentum changes by 3 kg\u00b7m/s in the force direction."
      ],
      "verifier": "impulse"
    }
