# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
.env
.env.*
!.env.example

# Test / tooling
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# Secrets — never commit
**/credentials*
**/*secret*
**/OPENROUTER*

# Local reference corpus — never commit or publish
/downloaded_by_consti/
**/downloaded_by_consti/

# SEC raw/cache material is released as an external artifact, not ordinary Git
/data/banking/sec/raw/
/data/banking/sec/*/filings/
/data/banking/sec/*/submissions.json
/data/banking/sec/*/companyfacts.json
/data/swivelbench-content-v1-sec-raw.tar.zst

# Local run workdirs (regenerate via materialize / --keep)
eval/results/runs/
eval/results/latest.json

# Keep checked-in baseline JSON summaries; ignore huge accidental dumps
*.db
